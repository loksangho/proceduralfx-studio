-
-    static const char months[12][4] =
-        {
-            "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
-        };
-
-    // format from RFC 3164 : BSD syslog Protocol
-    std::stringstream ss;
-    ss << "<" << priority << + ">"
