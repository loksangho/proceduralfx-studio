# Copy to .env for local runs (never commit .env). On the host, set these as secrets.

# Where users' browsers reach the server (links in emails, Stripe redirects). No trailing slash.
PUBLIC_URL=http://localhost:8787
PORT=8787

# Anthropic: a key from your own organisation (console.anthropic.com -> API Keys). Users never see it.
ANTHROPIC_API_KEY=

# Postgres. Leave empty to keep everything in memory (local testing only: lost on restart).
DATABASE_URL=

# Stripe: the secret key, and the signing secret of the webhook pointing at $PUBLIC_URL/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The currency for credit, plans and top-ups, and how many of it make one US dollar
# (Anthropic bills in USD). Set USD_RATE a little above the market rate as a buffer
# against exchange-rate swings, and review it every few months. For usd, USD_RATE=1.
CURRENCY=aud
USD_RATE=1.60

# Monthly plans: id=Stripe price id=credit each month (in CURRENCY), comma separated.
# The price (e.g. A$12/month) is set on the Stripe price, in the same currency.
PLANS=basic=price_XXXX=12,pro=price_YYYY=30
# One-off top-ups in whole units of CURRENCY (credit = amount paid). These never expire.
TOPUPS=5,10,25

# Your margin on top of Anthropic's price: 0.25 charges 1.25x what the tokens cost you.
MARGIN=0.25
# Credit for new accounts (in CURRENCY), e.g. 0.10 so people can try it. 0 for none.
FREE_CREDIT=0

# Sign-in emails via Resend (resend.com). Leave empty to print the links to the log instead.
RESEND_API_KEY=
EMAIL_FROM=ProceduralFX Studio <login@example.com>

# For GET /admin/stats (a long random string). Empty disables it.
ADMIN_TOKEN=

# The Founder's license, sold from the website (its Buy button opens $PUBLIC_URL/founder).
# FOUNDER_SEATS is how many are for sale; 0 or empty keeps it off. The price is in whole
# units of CURRENCY, and FOUNDER_CREDIT is the AI credit each buyer gets (in CURRENCY).
# The Stripe webhook needs checkout.session.completed (already used for top-ups).
FOUNDER_SEATS=100
FOUNDER_PRICE=49
FOUNDER_CREDIT=10

# Stripe Tax. off: no tax is calculated. inclusive: the prices above include any tax (A$49
# is the total; you receive less where tax applies). exclusive: tax is added at checkout.
# Set up Stripe Tax in the dashboard first (origin address, product tax code, the places
# you're registered), or every checkout fails. Stripe only collects tax where you've added
# a registration; elsewhere it calculates none but tracks how close you are to registering.
STRIPE_TAX=off
